version: 2
ethernets:
  eth0:
    match:
      macaddress: "{{ mac }}"
    set-name: eth0
    dhcp4: false
    addresses:
      - {{ ansible_host }}/{{ prefix }}
    routes:
      - to: 0.0.0.0/0
        via: {{ gateway }}
    nameservers:
      addresses:
        - {{ dns }}
      search:
        - {{ domain }}
