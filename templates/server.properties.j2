# Managed by Ansible (04_configure_kafka.yml) - based on Kafka 4.3 config/server.properties
############################# KRaft (single node: broker + controller) #############################
process.roles=broker,controller
node.id=1
controller.quorum.bootstrap.servers=127.0.0.1:{{ kafka_controller_port }}
controller.listener.names=CONTROLLER

############################# Listeners #############################
# PLAINTEXT: local admin/tools only. SSL: forwarders (OpenShift Logging). CONTROLLER: local only.
listeners=PLAINTEXT://127.0.0.1:{{ kafka_plain_port }},SSL://0.0.0.0:{{ kafka_ssl_port }},CONTROLLER://127.0.0.1:{{ kafka_controller_port }}
advertised.listeners=PLAINTEXT://127.0.0.1:{{ kafka_plain_port }},SSL://{{ kafka_fqdn }}:{{ kafka_ssl_port }},CONTROLLER://127.0.0.1:{{ kafka_controller_port }}
inter.broker.listener.name=PLAINTEXT
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,SSL:SSL

############################# TLS (PEM: PKCS#8 key followed by cert chain) #############################
ssl.keystore.type=PEM
ssl.keystore.location=/etc/kafka/tls/kafka-keystore.pem
ssl.client.auth=none

############################# Threads / sockets (Kafka defaults) #############################
num.network.threads=3
num.io.threads=8
socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600

############################# Storage #############################
log.dirs={{ kafka_data_mount }}/data
num.recovery.threads.per.data.dir=2

############################# Single-node replication #############################
offsets.topic.replication.factor=1
share.coordinator.state.topic.replication.factor=1
share.coordinator.state.topic.min.isr=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1

############################# Size caps (nothing accumulates) #############################
auto.create.topics.enable=false
num.partitions={{ kafka_default_partitions }}
log.cleanup.policy=delete
log.retention.hours={{ kafka_default_retention_hours }}
log.retention.bytes={{ kafka_default_retention_bytes }}
log.segment.bytes={{ kafka_default_segment_bytes }}
log.roll.hours={{ kafka_default_roll_hours }}
log.retention.check.interval.ms=300000
